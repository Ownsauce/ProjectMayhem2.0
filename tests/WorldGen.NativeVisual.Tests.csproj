    <Compile Include="../AO.Unity/Assets/Scripts/AO.Unity/World/NativeDungeons/NativeIndoorSurfaceTriangles.cs" />
    <Compile Include="../AO.Unity/Assets/Scripts/AO.Unity/World/DirectOutdoor/Abiff/AbiffMeshSnapshot.cs" />
    <Compile Include="../AO.Unity/Assets/Scripts/AO.Unity/World/DirectOutdoor/Abiff/AbiffSubmeshSource.cs" />
    <Compile Include="../AO.Unity/Assets/Scripts/AO.Unity/World/DirectOutdoor/Abiff/AbiffMaterialDesc.cs" />
    <Compile Include="../AO.Unity/Assets/Scripts/AO.Unity/World/DirectOutdoor/Abiff/AbiffUvKey.cs" />
    <Reference Include="AODB"><HintPath>../AO.Unity/Assets/Plugins/AODB/AODB.dll</HintPath></Reference>
    <Reference Include="AODB.Common"><HintPath>../AO.Unity/Assets/Plugins/AODB/AODB.Common.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
